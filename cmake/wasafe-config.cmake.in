@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# zstd линкуется PRIVATE, но у статической библиотеки он всё равно уезжает в
# INTERFACE_LINK_LIBRARIES как $<LINK_ONLY:zstd::libzstd>.
if(@WASAFE_EXPORT_NEEDS_ZSTD@)
    find_dependency(zstd)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/wasafe-targets.cmake")

check_required_components(wasafe)
