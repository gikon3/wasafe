# Базовый профиль CI: clang 22 + libstdc++, C++23, Debug.

[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version=22
compiler.libcxx=libstdc++11
compiler.cppstd=23
build_type=Debug

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={"c": "clang-22", "cpp": "clang++-22"}
# Флаги сборки по умолчанию НЕ входят в package_id: без этой строки бинарь
# зависимости, собранный с ASan, и он же с TSan получили бы один и тот же ID,
# и Conan подставлял бы «не тот» вариант из кеша.
tools.info.package_id:confs=["tools.build:cxxflags", "tools.build:cflags", "tools.build:exelinkflags", "tools.build:sharedlinkflags"]
